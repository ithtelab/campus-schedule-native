<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CampusAppGroup</key><string>$(CAMPUS_APP_GROUP)</string>
<key>CampusDemoEdition</key><true/>
<key>ITSAppUsesNonExemptEncryption</key><false/>
<key>NSSupportsLiveActivities</key><true/>
<key>UIBackgroundModes</key><array><string>fetch</string></array>
<key>BGTaskSchedulerPermittedIdentifiers</key><array><string>com.ithtelab.campustimetable.academic-refresh</string></array>
<!-- WebKit 兼容学校登录页面。后台检查仅对青岛工学院的教务主机放行 HTTP。 -->
<key>NSAppTransportSecurity</key><dict>
<key>NSAllowsArbitraryLoadsInWebContent</key><true/>
<key>NSExceptionDomains</key><dict>
  <key>jw.qit.edu.cn</key><dict>
    <key>NSExceptionAllowsInsecureHTTPLoads</key><true/>
  </dict>
</dict>
</dict>
<key>UIAppFonts</key><array><string>CampusHand.ttf</string></array>
<key>CFBundleURLTypes</key><array><dict><key>CFBundleURLSchemes</key><array><string>campusschedule</string></array></dict></array>
</dict></plist>
