{
  "cli": {
    "version": ">= 27.2.0",
    "appVersionSource": "local"
  },
  "build": {
    "simulator": {
      "ios": {
        "simulator": true,
        "scheme": "CampusSchedule",
        "buildConfiguration": "Release",
        "image": "macos-tahoe-26.6-xcode-27.0",
        "resourceClass": "medium"
      }
    },
    "native-check": {
      "extends": "simulator",
      "config": "native-check.yml"
    },
    "ui-screenshots": {
      "extends": "simulator",
      "config": "ui-screenshots.yml"
    }
  }
}
